#!/bin/sh /etc/rc.common
# WorkBuddy2API-Hub · OpenWrt 版 服务脚本
#
# 用 procd 常驻 python3 -m wb_proxy（PYTHONPATH 指向 /usr/lib/workbuddy2api），参数全部来自
# UCI（/etc/config/workbuddy2api）。改完 uci commit 后 restart 生效。
#
# 数据（账号凭据 + 用量）在 /etc/workbuddy2api/，已加入 sysupgrade 保留列表。

START=99
STOP=10
USE_PROCD=1

PROG_DIR=/usr/lib/workbuddy2api
# 入口用 -m（#702）：以脚本方式启动时模块名是 __main__，实测常驻多
# 47-54 MB（Windows / aarch64 四套环境一致），512 MB 设备上约 10%。

start_service() {
	local host port accounts_dir usage_dir api_key panel_password stats_ttl
	local tls_mode_setting tls_bridge_setting tls_bridge tls_fingerprint
	local bridge_machine bridge_binary
	config_load workbuddy2api
	config_get host main host '0.0.0.0'
	config_get port main port '8788'
	config_get accounts_dir main accounts_dir '/etc/workbuddy2api/accounts'
	config_get usage_dir main usage_dir '/etc/workbuddy2api/usage'
	config_get api_key main api_key ''
	config_get panel_password main panel_password ''
	# 统计缓存 TTL（秒）。应用默认 15s：面板每 5s 轮询、每次缓存过期都要
	# 全量重扫 usage.jsonl（2 万行在 N2840 上约 11-16s），默认值会让进程
	# 长期 100% 忙于重建、面板与代理请求都被拖慢。默认 900（15 分钟）配合
	# 预热器（workbuddy2api-warm，每 2 分钟跑一遍）让面板点开即是毫秒级；
	# 代价是聚合数字最多滞后这么久（「最近请求」表不受影响，它是读文件尾部）。
	# 限额判定不受影响——限额为 0 时那条扫描路径本来就不执行；用了限额的话
	# 这个值别调太大（限额计数也吃这份缓存）。
	config_get stats_ttl main stats_ttl '900'
	# TLS 传输模式：auto（默认，先试随包 Go/uTLS，失败一次性回退
	# Python/OpenSSL）、node（强制桥）或 python（强制 Python）。
	# 旧版只有 tls_bridge=0/1；升级时没有 tls_mode 的配置迁移为 auto，
	# 这样普通用户不需要重新配置。旧 tls_bridge=1 保留为 node 意图。
	config_get tls_mode_setting main tls_mode ''
	config_get tls_bridge_setting main tls_bridge ''
	if [ -z "$tls_mode_setting" ]; then
		case "$tls_bridge_setting" in
			1|on|true|yes|enabled|node)
				tls_mode_setting=node
				logger -t workbuddy2api \
					"TLS: 旧 tls_bridge 已启用，迁移为 tls_mode=node"
				;;
			*)
				tls_mode_setting=auto
				logger -t workbuddy2api \
					"TLS: 新增 tls_mode=auto（旧 tls_bridge 未显式启用；如需 Python 请设置 tls_mode=python）"
				;;
		esac
		# 只写 TLS 选择键，不触碰账号、API Key、代理槽或 usage。
		uci -q set workbuddy2api.main.tls_mode="$tls_mode_setting" 2>/dev/null
		uci -q commit workbuddy2api 2>/dev/null
	fi
	case "$tls_mode_setting" in
		auto|'')
			tls_fingerprint=auto
			tls_bridge=auto
			;;
		node)
			tls_fingerprint=node
			tls_bridge=auto
			;;
		python|0|off|false|no|native|stdlib)
			tls_fingerprint=python
			tls_bridge=off
			;;
		*)
			logger -t workbuddy2api \
				"TLS: 未知 tls_mode='$tls_mode_setting'，按 auto 处理"
			tls_fingerprint=auto
			tls_bridge=auto
			;;
	esac

	# 只用于给出可操作的告警，不改变 auto 的回退语义；node 缺桥仍由
	# wb_upstream_pool 返回明确错误，不能静默假装桥已生效。
	bridge_machine="$(uname -m 2>/dev/null)"
	case "$bridge_machine" in
		x86_64|amd64) bridge_binary="$PROG_DIR/bin/wb-tls-bridge-linux-amd64" ;;
		aarch64|arm64) bridge_binary="$PROG_DIR/bin/wb-tls-bridge-linux-arm64" ;;
		armv7l) bridge_binary="$PROG_DIR/bin/wb-tls-bridge-linux-arm" ;;
		*) bridge_binary="" ;;
	esac
	if [ "$tls_fingerprint" != "python" ] && \
		{ [ -z "$bridge_binary" ] || [ ! -x "$bridge_binary" ]; }; then
		if [ "$tls_fingerprint" = "node" ]; then
			logger -t workbuddy2api \
				"uTLS bridge 不可用（CPU: ${bridge_machine:-unknown}，二进制: ${bridge_binary:-无}）；node 请求将返回明确错误"
		else
			logger -t workbuddy2api \
				"uTLS bridge 不可用（CPU: ${bridge_machine:-unknown}，二进制: ${bridge_binary:-无}）；auto 将回退 Python/OpenSSL"
		fi
	fi

	mkdir -p "$accounts_dir" "$usage_dir"
	chmod 700 "$accounts_dir" 2>/dev/null

	procd_open_instance
	# --lan 确保监听所有接口时必然带 API Key（没配置就用面板生成并持久化的那个），
	# 否则网关会裸奔在局域网上，谁都能耗账号额度。
	procd_set_param command /usr/bin/python3 -m wb_proxy \
		--lan --host "$host" --port "$port" \
		--accounts-dir "$accounts_dir" --usage-dir "$usage_dir"
	[ -n "$api_key" ] && procd_append_param command --api-key "$api_key"
	[ -n "$panel_password" ] && procd_append_param command --panel-password "$panel_password"
	# procd 的 env 是整组设置：PYTHONPATH 必须和原有变量并成同一行，
	# 否则后一次调用会把前一次的变量清掉。
	procd_set_param env PYTHONPATH="$PROG_DIR" WB_STATS_TTL="$stats_ttl" WB_COUNT_TTL="$stats_ttl" WB_TLS_FINGERPRINT="$tls_fingerprint" WB_TLS_BRIDGE="$tls_bridge"
	# 进程意外退出时自动拉起（60 秒内崩 5 次就放弃，避免刷日志）
	procd_set_param respawn 60 10 5
	# 应用日志走 stderr（[wb-proxy] 行），启动横幅与端口占用等错误走 stdout，
	# 两路都进 syslog：logread -e wb-proxy 可看全部
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	# 服务刚起来时所有统计缓存都是空的，后台立刻预热一轮，免得用户正好在这时
	# 点开面板要等一次全表扫描（重启 / 升级后尤其明显）。预热器默认只在真的
	# 重建过（慢）或失败时才写 syslog。
	( /usr/bin/workbuddy2api-warm --quiet & ) >/dev/null 2>&1
}

stop_service() {
	logger -t workbuddy2api "服务停止"
}

reload_service() {
	logger -t workbuddy2api "配置已重载（restart 后生效）"
}
